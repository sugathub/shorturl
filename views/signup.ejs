<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950">

    <!-- Background Glow -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute top-0 left-0 w-96 h-96 bg-cyan-500/20 blur-3xl rounded-full"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-purple-500/20 blur-3xl rounded-full"></div>
    </div>

    <div class="bg-white/5 backdrop-blur-lg border border-white/10 shadow-2xl rounded-3xl p-8 w-full max-w-md">

        <h1 class="text-4xl font-extrabold text-center mb-6 bg-gradient-to-r from-cyan-400 to-purple-500 bg-clip-text text-transparent">
            Create Account
        </h1>

        <form action="/user/signup" method="POST" class="space-y-4">

            <div>
                <label class="block text-slate-300 mb-2">
                    Name
                </label>

                <input
                    type="text"
                    name="name"
                    placeholder="Enter your name"
                    required
                    class="w-full bg-slate-900 border border-slate-700 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500"
                >
            </div>

            <div>
                <label class="block text-slate-300 mb-2">
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                    class="w-full bg-slate-900 border border-slate-700 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500"
                >
            </div>

            <div>
                <label class="block text-slate-300 mb-2">
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    placeholder="Create a password"
                    required
                    class="w-full bg-slate-900 border border-slate-700 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500"
                >
            </div>

            <button
                type="submit"
                class="w-full bg-gradient-to-r from-cyan-500 to-purple-600 text-white py-3 rounded-xl font-semibold hover:scale-105 transition-all duration-300"
            >
                Sign Up
            </button>

        </form>

        <p class="text-center mt-6 text-slate-400">
            Already have an account?
            <a
                href="/login"
                class="text-cyan-400 hover:text-cyan-300 font-semibold"
            >
                Login
            </a>
        </p>

    </div>

</body>
</html>