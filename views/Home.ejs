<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-white">

    <!-- Background Effects -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute top-0 left-0 w-96 h-96 bg-cyan-500/20 blur-3xl rounded-full"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-purple-500/20 blur-3xl rounded-full"></div>
    </div>

    <div class="max-w-6xl mx-auto p-8">
        

        <!-- Heading -->
        <h2 class="text-5xl font-extrabold text-center mb-3 bg-gradient-to-r from-cyan-400 to-purple-500 bg-clip-text text-transparent">
            🚀 URL Shortener
        </h2>

        <p class="text-center text-slate-400 mb-10">
            Create, manage and track your shortened URLs
        </p>

        <!-- Generated URL -->
        <% if (locals.id) { %>
            <div class="bg-green-500/10 border border-green-500/30 text-green-300 p-5 rounded-2xl mb-8 backdrop-blur">
                <p class="font-semibold">
                    URL Generated:
                    <a
                        href="http://localhost:8001/<%= id %>"
                        target="_blank"
                        class="underline text-cyan-400 break-all"
                    >
                       <a href="<%= host %>/<%= id %>" target="_blank">
    <%= host %>/<%= id %>
</a>
                    </a>
                </p>
            </div>
        <% } %>

        <!-- Form -->
        <div class="bg-white/5 backdrop-blur-lg border border-white/10 shadow-2xl rounded-3xl p-6 mb-8">
            <form method="POST" action="/url" class="flex gap-4">

                <input
                    name="url"
                    type="text"
                    placeholder="https://example.com"
                    class="flex-1 bg-slate-900 border border-slate-700 text-white rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500"
                >

                <button
                    type="submit"
                    class="bg-gradient-to-r from-cyan-500 to-purple-600 text-white px-8 py-3 rounded-xl font-semibold hover:scale-105 transition-all duration-300"
                >
                    Generate
                </button>

            </form>
        </div>

        <!-- URLs Table -->
        <% if (locals.urls && urls.length > 0) { %>

        <div class="bg-white/5 backdrop-blur-lg border border-white/10 rounded-3xl overflow-hidden shadow-2xl">

            <table class="w-full">

                <thead class="bg-gradient-to-r from-cyan-500 to-purple-600 text-white">
                    <tr>
                        <th class="px-4 py-4 text-left">#</th>
                        <th class="px-4 py-4 text-left">Short ID</th>
                        <th class="px-4 py-4 text-left">Original URL</th>
                        <th class="px-4 py-4 text-left">Clicks</th>
                        <th class="px-4 py-4 text-left">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% urls.forEach((url, index) => { %>

                        <tr class="border-b border-slate-700 hover:bg-white/5 transition">

                            <td class="px-4 py-4">
                                <%= index + 1 %>
                            </td>

                            <td class="px-4 py-4 font-semibold text-cyan-400">
                                <%= url.shortId %>
                            </td>

                            <td class="px-4 py-4 break-all text-slate-300">
                                <%= url.redirectURL %>
                            </td>

                            <td class="px-4 py-4">
                                <%= url.visitHistory.length %>
                            </td>

                            <td class="px-4 py-4">
                                <div class="flex gap-2">

                                    <button
                                        onclick="copyUrl('<%= host %>/<%= url.shortId %>')"
                                        class="bg-cyan-500 hover:bg-cyan-600 text-white px-4 py-2 rounded-lg transition"
                                    >
                                        Copy
                                    </button>

                                    <form
                                        action="/url/delete/<%= url.shortId %>"
                                        method="POST"
                                        onsubmit="return confirm('Delete this URL?')"
                                    >
                                        <button
                                            type="submit"
                                            class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition"
                                        >
                                            Delete
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

        <% } %>

    </div>

    <script>
        function copyUrl(url) {
            navigator.clipboard.writeText(url)
                .then(() => {
                    alert("Short URL copied!");
                })
                .catch((err) => {
                    console.error("Failed to copy:", err);
                });
        }
    </script>

</body>
</html>